# TerraNav Frontend Environment Configuration

# Backend API URL (leave empty when using Vite dev proxy or same-origin deployment)
VITE_API_BASE_URL=

# Backend target for Vite dev server proxy (Backend runs on port 5000)
VITE_BACKEND_URL=http://localhost:5000

# Map Dark Tiles URL (CARTO Dark Matter)
VITE_MAP_DARK_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png?key=your_carto_api_key_here
