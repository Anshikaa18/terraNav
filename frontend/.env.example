# TerraNav Frontend Environment Configuration

# Production Backend API URL for Vercel deployment (e.g., https://terranav-backend.onrender.com)
# In local development using Vite proxy, leave empty or unset.
VITE_API_URL=

# Fallback Backend API URL (for backwards compatibility)
VITE_API_BASE_URL=

# Backend target for Vite dev server local proxy (Backend runs on port 5000)
VITE_BACKEND_URL=http://localhost:5000

# Map Dark Tiles URL (CARTO Dark Matter or ArcGIS)
VITE_MAP_DARK_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png?key=your_carto_api_key_here

# TomTom Maps is served securely from the backend tile proxy. Never add TOMTOM_API_KEY
# or any other credentials to this frontend environment file.
