{
  "name": "terranav-monorepo",
  "version": "1.0.0",
  "description": "TerraNav: Dynamic Route Rationalization, Traffic Prediction and Navigation Monorepo",
  "main": "backend/api/server.js",
  "scripts": {
    "start": "node backend/api/server.js",
    "dev": "node backend/api/server.js",
    "start:backend": "node backend/api/server.js",
    "start:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "test:backend:all": "npm --prefix backend run test:all",
    "test:frontend": "npm --prefix frontend test",
    "test:ml": "python -m unittest discover -s backend/ml/tests -t backend/ml -p \"test_*.py\" -v",
    "test": "npm run test:backend",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:ml"
  },
  "keywords": [
    "terranav",
    "chunkflow",
    "dynamic-routing",
    "traffic-prediction",
    "aiven-mysql",
    "astar-optimizer"
  ],
  "author": "TerraNav Team",
  "license": "ISC"
}