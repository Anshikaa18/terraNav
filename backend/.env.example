# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Aiven)
DB_HOST=mysql-your-project-name.k.aivencloud.com
DB_PORT=21483
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password_here
DB_NAME=terranav_db
DB_SSL=true

# Persistence: keep false outside local demos/tests. Production requires MySQL.
ALLOW_IN_MEMORY_DB=false

# JWT Authentication - MUST be at least 32 characters of high-entropy random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_secret_key
JWT_EXPIRES_IN=7d

# External Geospatial and Routing Services
# Car routing uses OSRM's driving profile. Bike, bicycle, and walking modes
# require a Valhalla server at this URL with the corresponding costing profiles.
# Routing fails clearly for those modes when that provider/profile is unavailable;
# it never silently substitutes OSRM driving.
VALHALLA_BASE_URL=http://localhost:8002
OSRM_BASE_URL=http://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Live traffic (server-side only). TomTom is preferred when configured. Never put
# either key in frontend variables or source control. A route is marked live only
# when an observed/free-flow speed is direction-matched and used in its ETA.
TOMTOM_API_KEY=
TERRANAV_TRAFFIC_UPDATE_TOKEN=
GEOCODING_PROVIDER=tomtom
TOMTOM_SEARCH_URL=https://api.tomtom.com/search/2/search
TOMTOM_REVERSE_GEOCODE_URL=https://api.tomtom.com/search/2/reverseGeocode
TOMTOM_SEARCH_TIMEOUT_MS=5000
TOMTOM_FLOW_URL=https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json
TOMTOM_INCIDENTS_URL=https://api.tomtom.com/traffic/services/5/incidentDetails
TOMTOM_MAX_FRESH_AGE_MS=300000
HERE_TRAFFIC_API_KEY=
HERE_TRAFFIC_FLOW_URL=https://data.traffic.hereapi.com/v7/flow
TRAFFIC_CACHE_TTL_MS=60000
TRAFFIC_MATCH_TOLERANCE_METERS=85
TRAFFIC_PROVIDER_TIMEOUT_MS=4500

# ChunkFlow worker. It needs the exact train-fitted preprocessing bundle in ML/;
# without it predictions are deliberately unavailable.
CHUNKFLOW_PYTHON=python
CHUNKFLOW_TIMEOUT_MS=3500

# CORS Configuration - Comma-separated list of allowed frontend origins (never '*' in production)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
